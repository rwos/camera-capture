[Unit]
Description=Analog video recorder (DVX-Nebula)
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
# Configure the ADV7280 chip before starting the recorder
ExecStartPre=/usr/bin/python3 /home/pi/setup-adv.py
ExecStart=/usr/bin/python3 /home/pi/recorder.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
